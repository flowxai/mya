#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE_PATH}" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "${SOURCE_PATH}")" && pwd)"
  SOURCE_PATH="$(readlink "${SOURCE_PATH}")"
  [[ "${SOURCE_PATH}" != /* ]] && SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}"
done

SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE_PATH}")" && pwd)"
CLI_PATH="${SCRIPT_DIR}/../cli"
CONNECT_RUNTIME_DIR="${SCRIPT_DIR}/../runtime/connect"
CONNECT_ENTRY="${CONNECT_RUNTIME_DIR}/bin/mya-connect.js"
CONNECT_NODE_MODULES="${CONNECT_RUNTIME_DIR}/node_modules"
INSTALLER_PATH="${SCRIPT_DIR}/../install.sh"

print_product_help() {
  cat <<'EOF'

Product Commands:
  Bots:
    mya bots                    List saved bots and choose one to open
    mya bots add <name>         Create a bot in the current workspace and open it
    mya bots remove <name>      Remove a saved bot and its BOT.md

  Channels:
    mya wechat login [bot]      Login WeChat and bind it to a bot
    mya wechat accounts         Show saved WeChat accounts
    mya feishu login [bot]      Save Feishu app credentials for a bot
    mya feishu check            Validate Feishu app credentials

  Service:
    mya serve                   Start every configured bot/channel together

  First-time Bot Setup:
    mya bots add review-bot     Create a new bot and open it immediately
    /whoru                      Explain or save the bot's identity and purpose

Notes:
  - omitting [bot] uses the `default` bot
  - `mya bots add <name>` writes both `profile.json` and `BOT.md`
  - WeChat can only be bound to one bot at a time
  - each Feishu bot keeps its own appId/appSecret inside that bot profile
  - `mya serve` starts every bot that already has a bound wechat or feishu channel
  - advanced debug commands still exist: `mya serve status|restart|stop|logs`, `mya wechat start`, `mya feishu start`
  - current session diagnostics still use `/status`, `/tasks`, `/doctor`, `/agents`
EOF
}

sanitize_base_help() {
  perl -0pe '
    s/Claude Code/mya/g;
    s/Manage Claude Code plugins/Manage mya plugins/g;
    s/Check the health of your Claude Code auto-updater\./Check the health of your mya auto-updater./g;
    s/Install Claude Code native build\./Install mya native build./g;
    s/Enable Claude in Chrome integration/Enable browser integration/g;
    s/Disable Claude in Chrome integration/Disable browser integration/g;
    s/requires Claude subscription/requires an active subscription/g;
    s/when Claude is run/when mya is run/g;
    s/CLAUDE\.md auto-discovery/project-instructions auto-discovery/g;
    s/CLAUDE\.md dirs/project-instructions dirs/g;
  '
}

print_combined_help() {
  "${CLI_PATH}" --help | sanitize_base_help
  print_product_help
}

run_installer() {
  if [[ ! -f "${INSTALLER_PATH}" ]]; then
    echo "[mya] installer is missing at ${INSTALLER_PATH}" >&2
    exit 1
  fi

  exec "${INSTALLER_PATH}" "$@"
}

is_connect_command() {
  case "${1:-}" in
    connect|wechat|feishu|bots|serve)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  print_combined_help
  exit 0
fi

if is_connect_command "${1:-}"; then
  if [[ "${1:-}" == "connect" ]]; then
    shift
  fi

  if [[ ! -f "${CONNECT_ENTRY}" ]]; then
    echo "[mya] bundled channel runtime is missing at ${CONNECT_ENTRY}" >&2
    exit 1
  fi

  if [[ ! -d "${CONNECT_NODE_MODULES}" ]]; then
    echo "[mya] bundled channel runtime dependencies are missing." >&2
    echo "[mya] run 'bun run setup' or './install.sh' first." >&2
    exit 1
  fi

  if ! command -v node >/dev/null 2>&1; then
    echo "[mya] Node.js >= 22 is required to run mya wechat / mya feishu / mya serve." >&2
    exit 1
  fi

  export MYA_CONNECT_MAIN_COMMAND="${MYA_CONNECT_MAIN_COMMAND:-${CLI_PATH}}"
  exec node "${CONNECT_ENTRY}" "$@"
fi

if [[ "${1:-}" == "update" || "${1:-}" == "self-update" ]]; then
  shift
  run_installer --upgrade --release "$@"
fi

if [[ "${1:-}" == "install" ]]; then
  shift
  run_installer "$@"
fi

exec "${CLI_PATH}" "$@"
