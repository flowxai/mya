# Shared binary
# Leave these blank if you run connectors through the bundled `mya connect` wrapper.
MYA_CONNECT_WECHAT_MYA_COMMAND=mya
MYA_CONNECT_FEISHU_MYA_COMMAND=mya

# =========================
# WeChat
# =========================
MYA_CONNECT_WECHAT_ACCOUNT_ID=
MYA_CONNECT_WECHAT_PRESERVE_EXISTING_ACCOUNTS=true
MYA_CONNECT_WECHAT_AUTO_SELECT_LATEST_ACCOUNT=true
MYA_CONNECT_WECHAT_QR_BOT_TYPE=3
MYA_CONNECT_WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
MYA_CONNECT_WECHAT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
MYA_CONNECT_WECHAT_ALLOWED_USER_IDS=
MYA_CONNECT_WECHAT_DEFAULT_WORKSPACE=
MYA_CONNECT_WECHAT_WORKSPACE_ALLOWLIST=
MYA_CONNECT_WECHAT_DEFAULT_MODEL=sonnet
MYA_CONNECT_WECHAT_DEFAULT_EFFORT=
MYA_CONNECT_WECHAT_PERMISSION_MODE=dontAsk
MYA_CONNECT_WECHAT_ENABLE_AUTO_MODE=false
MYA_CONNECT_WECHAT_ENABLE_TYPING=true
MYA_CONNECT_WECHAT_DEFAULT_WORKSPACE_ID=default
MYA_CONNECT_WECHAT_STATE_DIR=/Users/your-name/.mya/connect/wechat
MYA_CONNECT_WECHAT_SESSIONS_FILE=/Users/your-name/.mya/connect/wechat/sessions.json
MYA_CONNECT_WECHAT_SYNC_BUFFER_DIR=/Users/your-name/.mya/connect/wechat/sync-buf

# =========================
# Feishu
# =========================
MYA_CONNECT_FEISHU_APP_ID=
MYA_CONNECT_FEISHU_APP_SECRET=
MYA_CONNECT_FEISHU_ALLOWED_OPEN_IDS=
MYA_CONNECT_FEISHU_DEFAULT_WORKSPACE=
MYA_CONNECT_FEISHU_WORKSPACE_ALLOWLIST=
MYA_CONNECT_FEISHU_DEFAULT_WORKSPACE_ID=default
MYA_CONNECT_FEISHU_DEFAULT_MODEL=sonnet
MYA_CONNECT_FEISHU_DEFAULT_EFFORT=
MYA_CONNECT_FEISHU_PERMISSION_MODE=dontAsk
MYA_CONNECT_FEISHU_ENABLE_AUTO_MODE=false
MYA_CONNECT_FEISHU_ENABLE_GROUP_AT=true
MYA_CONNECT_FEISHU_REPLY_IN_THREAD=false
MYA_CONNECT_FEISHU_STATE_DIR=/Users/your-name/.mya/connect/feishu
MYA_CONNECT_FEISHU_SESSIONS_FILE=/Users/your-name/.mya/connect/feishu/sessions.json
