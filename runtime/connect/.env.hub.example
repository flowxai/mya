# Hub defaults
# Copy to ~/.mya-connect/.env or ~/.mya-connect/hub/.env before running:
#   mya serve
#
# Profiles live under:
#   ~/.mya-connect/hub/profiles/<profile-id>/profile.json
#
# Example profiles live under:
#   connect/examples/profiles/

# Shared mya binary
MYA_CONNECT_WECHAT_MYA_COMMAND=mya
MYA_CONNECT_FEISHU_MYA_COMMAND=mya

# Shared workspace defaults
MYA_CONNECT_WECHAT_DEFAULT_MODEL=sonnet
MYA_CONNECT_WECHAT_PERMISSION_MODE=plan
MYA_CONNECT_WECHAT_ENABLE_AUTO_MODE=false
MYA_CONNECT_FEISHU_DEFAULT_MODEL=sonnet
MYA_CONNECT_FEISHU_PERMISSION_MODE=plan
MYA_CONNECT_FEISHU_ENABLE_AUTO_MODE=false
MYA_CONNECT_FEISHU_ENABLE_GROUP_AT=true

# Global default permission mode can also be set in ~/.my_agent/settings.json:
# {
#   "env": { "MYA_DEFAULT_PERMISSION_MODE": "dangerously-skip-permissions" }
# }

# Shared state directories
MYA_CONNECT_WECHAT_STATE_DIR=/Users/your-name/.mya-connect/wechat
MYA_CONNECT_WECHAT_SESSIONS_FILE=/Users/your-name/.mya-connect/wechat/sessions.json
MYA_CONNECT_WECHAT_SYNC_BUFFER_DIR=/Users/your-name/.mya-connect/wechat/sync-buf
MYA_CONNECT_FEISHU_STATE_DIR=/Users/your-name/.mya-connect/feishu
MYA_CONNECT_FEISHU_SESSIONS_FILE=/Users/your-name/.mya-connect/feishu/sessions.json

# Optional connector defaults
MYA_CONNECT_WECHAT_AUTO_SELECT_LATEST_ACCOUNT=false
MYA_CONNECT_WECHAT_PRESERVE_EXISTING_ACCOUNTS=true
MYA_CONNECT_WECHAT_QR_BOT_TYPE=3
MYA_CONNECT_FEISHU_REPLY_IN_THREAD=false

# Optional scheduler/event defaults referenced by example profiles
MYA_CONNECT_HUB_EVENTS_DIR=/Users/your-name/.mya-connect/hub/events
